# ---- Website ----
# Produktiv-Domain ohne abschließenden Slash (Canonical, Sitemap, Open Graph)
VITE_SITE_URL=https://www.auto-semmel.de
# Deployment-Ziel für den Build (node-server | vercel | netlify | cloudflare-module ...)
NITRO_PRESET=node-server

# ---- Supabase (eigenes Projekt) ----
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
# NUR Server, niemals im Browser/Repo veröffentlichen:
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ---- Benachrichtigungen ----
# Empfänger neuer Kundenanfragen (kommagetrennt, nur Server)
LEAD_NOTIFY_EMAIL=verkauf@auto-semmel.de
# Geheimer Token für den Fahrzeug-Import per API (langer Zufallswert)
IMPORT_API_TOKEN=
